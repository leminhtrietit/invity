# local | staging | production
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set this server-only value in every environment to prevent a Vercel preview
# deployment from accidentally connecting to the production Supabase project.
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF

# Supabase Project Settings > API. Publishable key is safe for the browser;
# never expose service-role/secret keys as NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Tạo template riêng trong My VietQR trước production; compact2 dùng cho local/preview.
VIETQR_TEMPLATE_ID=compact2

# Secret ngẫu nhiên tối thiểu 32 byte, chỉ lưu trong Supabase secret store.
# Scheduler gửi giá trị này bằng header X-Worker-Secret để chạy cleanup/purge.
MEDIA_WORKER_SECRET=SET_IN_SUPABASE_SECRET_STORE_ONLY
