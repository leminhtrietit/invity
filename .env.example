# local | staging | production
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set this server-only value in every environment to prevent a Vercel preview
# deployment from accidentally connecting to the production Supabase project.
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF

# Supabase Project Settings > API. Publishable key is safe for the browser;
# never expose service-role/secret keys as NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
